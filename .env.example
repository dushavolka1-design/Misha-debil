# Local development artificial values only.
# Copy to .env and adjust. Never commit .env.
# Production MUST override every secret and FORBID fake providers / SQLite.

APP_ENV=local
APP_NAME=document-analyzer-rf
LOG_LEVEL=INFO

# Synthetic local secrets — replace before any shared/staging use
POSTGRES_USER=dar_local
POSTGRES_PASSWORD=dar_local_password_change_me
POSTGRES_DB=dar_local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://dar_local:dar_local_password_change_me@localhost:5432/dar_local

REDIS_URL=redis://localhost:6379/0
QUEUE_NAME=dar-jobs

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=dar_minio_access
S3_SECRET_KEY=dar_minio_secret_change_me
S3_BUCKET_ORIGINALS=dar-originals
S3_BUCKET_DERIVED=dar-derived
S3_BUCKET_REPORTS=dar-reports
S3_BUCKET_QUARANTINE=dar-quarantine
S3_REGION=us-east-1

# Retention placeholders (RETENTION_*_NEEDS_REVIEW) — local defaults only
RETENTION_ORIGINALS_DAYS=30
RETENTION_DERIVED_DAYS=60
RETENTION_REPORTS_DAYS=90
RETENTION_AUDIT_DAYS=365
UPLOAD_PRESIGN_TTL_SECONDS=600
SANDBOX_CPU_SECONDS=5
SANDBOX_MEMORY_MB=256

CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Providers: local stack by default; fake_* only with DEMO_MODE=true
DEMO_MODE=false
MAX_ANALYSIS_PAGES=50
OCR_PROVIDER=local_extract
LLM_PROVIDER=unavailable
OBJECT_STORAGE_PROVIDER=s3
MALWARE_SCANNER_PROVIDER=fake_malware
PAYMENT_PROVIDER=fake_payment
EMAIL_PROVIDER=fake_email
KMS_PROVIDER=fake_kms

# API
API_HOST=0.0.0.0
API_PORT=8000
API_PUBLIC_BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
SESSION_SECRET=local_session_secret_change_me_32chars_min

# Feature: allow fake providers only when APP_ENV is local or test
ALLOW_FAKE_PROVIDERS=true

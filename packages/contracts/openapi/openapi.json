{
  "openapi": "3.1.0",
  "info": {
    "title": "Document Analyzer RF API",
    "version": "0.1.0"
  },
  "paths": {
    "/live": {
      "get": {
        "tags": ["health"],
        "summary": "Liveness probe",
        "operationId": "live_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LiveResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["health"],
        "summary": "Basic health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": ["health"],
        "summary": "Readiness probe",
        "operationId": "ready_ready_get",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          },
          "503": {
            "description": "Not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LiveResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "default": "ok"
          }
        },
        "required": ["status"]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "default": "ok"
          },
          "service": {
            "type": "string"
          },
          "env": {
            "type": "string"
          }
        },
        "required": ["status", "service", "env"]
      },
      "ReadinessChecks": {
        "type": "object",
        "properties": {
          "database": { "type": "boolean" },
          "queue": { "type": "boolean" },
          "object_storage": { "type": "boolean" }
        },
        "required": ["database", "queue", "object_storage"]
      },
      "ReadinessResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ready", "not_ready"]
          },
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecks"
          }
        },
        "required": ["status", "checks"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "string"
          }
        },
        "required": ["detail"]
      }
    }
  }
}
